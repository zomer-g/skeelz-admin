# Local development. On xhostd these are set with set_env (secrets with secret=true).

# Postgres. xhostd injects DATABASE_URL per channel; locally point it at any Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skeelz

# Auth — XHOST SSO
ADMIN_EMAILS=
# Hostnames the identity cookie may be minted for (comma separated).
XHOST_AUTH_AUDIENCES=
# next dev only: impersonate this email (there is no xhostd edge on localhost).
DEV_AUTH_EMAIL=

# Salesforce (External Client App, Client Credentials flow) — M2
SF_LOGIN_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=65.0

# Google — M5
GA4_PROPERTY_ID=
GTM_ACCOUNT_ID=
GTM_CONTAINER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# SMOOV — M6
SMOOV_API_KEY=

# External API = SKEELZ Connect (/api/v1, docs at /api-docs, docs/connect-api.md). Keys are issued at /admin/api.
# Legacy shared tokens still work as keys, at least 32 characters: openssl rand -hex 32
# API_TOKEN (+ _PREVIOUS while rotating) = jobs:read metrics:read; SITE_FEED_TOKEN = site-feed:read only.
API_TOKEN=
API_TOKEN_PREVIOUS=
SITE_FEED_TOKEN=
# Encrypts the keys other apps issued to us (/admin/connections): 64 hex characters, openssl rand -hex 32
CONNECT_SECRET_KEY=
# Outgoing webhooks, sent by the sync worker: an https URL and the token that signs every event.
WEBHOOK_URL=
WEBHOOK_TOKEN=
